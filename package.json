{
  "name": "ftp-file-synchronizer",
  "productName": "FTP File Synchronizer",
  "desktopName": "ftp-file-synchronizer.desktop",
  "version": "2.0.0",
  "description": "Ferramenta de sincronização FTP automática",
  "author": {
    "name": "Edenilson Mota",
    "email": "edenilsonmota.job@gmail.com"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check src/preload.js && node --check src/main/application.js && node --check src/main/config/application.js && node --check src/main/config/settings-repository.js && node --check src/main/ftp/ftp-service.js && node --check src/main/ipc/register-handlers.js && node --check src/main/sync/sync-service.js && node --check src/main/ui/window-manager.js && node --check src/renderer/renderer.js",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.edenilson.ftpfilesynchronizer",
    "productName": "FTP File Synchronizer",
    "executableName": "ftp-file-synchronizer",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icons",
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "FTP File Synchronizer",
          "StartupWMClass": "ftp-file-synchronizer"
        }
      }
    },
    "pacman": {
      "artifactName": "${name}-${version}-${arch}.pkg.tar.zst",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "guid": "7e3ae7d1-cf32-4207-ab8a-d3c1a097531f",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FTP File Synchronizer"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.map",
      "!**/*.md",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "chokidar": "^3.5.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
